{
  "name": "al-sayahin-tribe",
  "version": "1.0.0",
  "description": "موقع ويب - Al-Sayahin Tribe Heritage Website",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "caveman": "caveman",
    "caveman:review": "caveman -p 'review this code carefully'",
    "caveman:explain": "caveman -p 'explain what this does'",
    "caveman:optimize": "caveman -p 'optimize and improve this code'"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.292.0",
    "motion": "^11.1.0",
    "@juliusbrussee/caveman-code": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  },
  "caveman": {
    "skills": [
      "code-review",
      "documentation-gen",
      "code-optimization",
      "typescript-analysis",
      "react-patterns"
    ],
    "mode": "compressed",
    "theme": "dark",
    "language": "en"
  }
}
